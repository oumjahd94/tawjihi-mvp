# Copier en ".env.local" (local) et dans Vercel > Settings > Environment Variables (prod)

# --- Supabase (Settings > API) — sans ces 2 clés, le site tourne en mode démo ---
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# --- Serveur uniquement (alertes WhatsApp) — NE JAMAIS préfixer par NEXT_PUBLIC_ ---
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=rappel_deadline
CRON_SECRET=une-longue-chaine-aleatoire
